# ==========================================
# Production & Deployment Environment Config
# ==========================================

# 1. Security & Authentication
ADMIN_EMAIL=admin@gmail.com
ADMIN_INITIAL_PASSWORD=SetAStrongUniquePasswordHere!
JWT_SECRET_KEY=SetALongRandomSecretKeyHere

# 2. Database Connection (SQLite default fallback if empty)
# PostgreSQL / AWS RDS: postgresql+psycopg://username:password@rds-endpoint.amazonaws.com:5432/workforce_db
DATABASE_URL=

# 3. AWS S3 Data Lake Integration
S3_BUCKET_NAME=your-workforce-data-lake-bucket
S3_DATA_PREFIX=workforce-data

# 4. CORS Origins Configuration (Comma-separated origins, or * for dev)
ALLOWED_ORIGINS=https://your-app-domain.com,http://localhost:5173

# 5. Environment Mode
ENVIRONMENT=production
